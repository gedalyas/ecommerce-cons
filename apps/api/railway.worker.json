{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile",
    "watchPatterns": ["apps/api/**", "packages/**", "package.json", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "node apps/api/dist/worker.mjs",
    "restartPolicyType": "ALWAYS"
  }
}
