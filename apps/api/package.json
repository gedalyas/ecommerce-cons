{
  "name": "@ecommerce/api",
  "version": "0.1.0",
  "description": "E-commerce Insights HTTP API (Express 4 + Zod + Prisma)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "dev:worker": "tsx watch --env-file=../../.env src/worker.ts",
    "start:worker": "node dist/worker.mjs",
    "start": "node dist/index.mjs",
    "build": "node build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:cycles": "tsx ../../scripts/checkCycles.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@ecommerce/contracts": "*",
    "@ecommerce/database": "*",
    "@fontsource/manrope": "^5.3.0",
    "@types/multer": "^2.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fflate": "^0.8.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.4",
    "nodemailer": "^7.0.13",
    "pdfmake": "^0.3.11",
    "pg-boss": "^10.4.2",
    "read-excel-file": "^9.3.10",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfmake": "^0.3.3",
    "esbuild": "^0.25.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  }
}
