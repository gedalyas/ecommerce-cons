// Data model for the e-commerce consulting dashboard.
//
// Every screen reads from these tables through the module services; the seed
// (prisma/seed.ts) is the single writer of the demo dataset. See
// specs/data-layer-migration.md.
//
// Naming: models and fields in English, @@map/@map to snake_case tables and
// columns. Values that reach the screen (labels, notes, recommendations) are
// stored in Portuguese because they are user-facing copy, not identifiers.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts `url` here: the connection string for migrate and
// introspection lives in prisma.config.ts, and the client gets a driver adapter.
datasource db {
  provider = "postgresql"
}

/// Data confidence seal shown next to every KPI.
/// A = measured, B = approximated, C = indicative.
enum Fidelity {
  A
  B
  C

  @@map("fidelity")
}

/// Progress of a pillar inside a section.
enum PillarStatus {
  DONE
  IN_PROGRESS
  NOT_STARTED
  BLOCKED

  @@map("pillar_status")
}

/// Sync state of an external data source.
enum DataSourceStatus {
  CONNECTED
  ERROR
  NOT_CONNECTED
  MANUAL

  @@map("data_source_status")
}

enum UserRole {
  ADMIN
  CONSULTANT
  CLIENT

  @@map("user_role")
}

enum ConnectionRequestStatus {
  REQUESTED
  IN_PROGRESS
  DONE
  DECLINED

  @@map("connection_request_status")
}

enum ImportKind {
  ORDERS
  AD_SPEND
  TRAFFIC

  @@map("import_kind")
}

enum ImportStatus {
  DONE
  PARTIAL
  FAILED
  UNDONE

  @@map("import_status")
}

/// One CSV upload through Conexões: what was sent, what got in, what was rejected.
model ImportJob {
  id           String       @id @default(cuid())
  clientId     String       @map("client_id")
  userId       String?      @map("user_id")
  kind         ImportKind
  status       ImportStatus
  fileName     String       @map("file_name")
  fileSize     Int          @map("file_size")
  rowsTotal    Int          @map("rows_total")
  rowsImported Int          @map("rows_imported")
  rowsRejected Int          @map("rows_rejected")
  /// First row errors, [{ row, message }], capped at 50.
  errors       Json
  createdAt    DateTime     @default(now()) @map("created_at")
  finishedAt   DateTime?    @map("finished_at")
  undoneAt     DateTime?    @map("undone_at")

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  undoEntries ImportUndo[]

  @@index([clientId, createdAt])
  @@map("import_job")
}

/// What an import touched, so it can be undone while it is the latest of its kind:
/// `previous` is null for a row the import created, or the JSON of the row it replaced.
model ImportUndo {
  id       String @id @default(cuid())
  jobId    String @map("job_id")
  /// ORDER · CUSTOMER · PRODUCT · AD_SPEND_DAY · TRAFFIC (closed set in the API).
  entity   String
  key      String
  previous Json?

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("import_undo")
}

/// Someone who signs in. CLIENT users belong to one store; consultants and admins have none
/// and reach stores through assignments (or everything, for admins).
model User {
  id           String   @id @default(cuid())
  clientId     String?  @map("client_id")
  email        String   @unique
  name         String
  /// scrypt hash, "salt:hash" in hex.
  passwordHash String   @map("password_hash")
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  client             Client?                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  importJobs         ImportJob[]
  assignments        ConsultantAssignment[]
  invitationsSent    Invitation[]
  connectionRequests ConnectionRequest[]
  auditEvents        AuditEvent[]

  @@index([clientId])
  @@map("user")
}

model ConsultantAssignment {
  id           String   @id @default(cuid())
  consultantId String   @map("consultant_id")
  clientId     String   @map("client_id")
  createdAt    DateTime @default(now()) @map("created_at")

  consultant User   @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([consultantId, clientId])
  @@map("consultant_assignment")
}

/// An e-mail released to use the product; a CLIENT invitation without a store lets the
/// invitee create one on first access.
model Invitation {
  id          String    @id @default(cuid())
  email       String    @unique
  role        UserRole
  clientId    String?   @map("client_id")
  invitedById String?   @map("invited_by_id")
  /// sha256 of the token sent by e-mail; cleared once accepted.
  tokenHash   String?   @unique @map("token_hash")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  acceptedAt  DateTime? @map("accepted_at")

  client    Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@map("invitation")
}

/// Rotating refresh tokens; only the sha256 of the token is stored.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset")
}

// ---------------------------------------------------------------------------
// Analytics facts (specs/data-module-plan.md). Everything the data screens
// show is a query over these tables; the presentation models above stay as
// the consulting layer on top.
// ---------------------------------------------------------------------------

/// Where the order was sold: the store's own site or a marketplace.
enum SalesPlatform {
  ECOMMERCE
  MARKETPLACE

  @@map("sales_platform")
}

/// Payment state of an order. Only PAID counts as revenue.
enum FinancialStatus {
  PAID
  PENDING
  AUTHORIZED
  CANCELLED
  REFUNDED

  @@map("financial_status")
}

enum ProcessingMethod {
  CREDIT_CARD
  PIX
  BOLETO

  @@map("processing_method")
}

enum AdPlatform {
  META
  GOOGLE
  TIKTOK

  @@map("ad_platform")
}

/// Which side of the business a cost belongs to.
enum BusinessUnit {
  ECOMMERCE
  MARKETPLACE
  BOTH

  @@map("business_unit")
}

/// Top-level DRE line a cost rolls into.
enum CostCategory {
  COGS
  SALES_MARKETING
  OPERATIONAL

  @@map("cost_category")
}

/// How a cost accrues. The PERCENT_* modes store percentage points in `value`.
enum CostFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  ONE_TIME
  PER_ORDER
  PERCENT_PER_ORDER
  PERCENT_OF_AD_SPEND

  @@map("cost_frequency")
}

/// Catalog product. Prices, costs and stock live on the variant.
model Product {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id")
  name        String
  /// Portuguese labels, e.g. "Decoração".
  category    String
  subcategory String?
  brand       String?
  collection  String?
  createdAt   DateTime @default(now()) @map("created_at")

  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  variants ProductVariant[]
  items    OrderItem[]

  @@index([clientId, category])
  @@map("product")
}

/// Sellable unit (SKU). Single-variant products have exactly one with name null.
model ProductVariant {
  id         String    @id @default(cuid())
  productId  String    @map("product_id")
  sku        String
  /// Variant label, e.g. "Azul · M". Null for single-variant products.
  name       String?
  price      Decimal   @db.Decimal(12, 2)
  /// Unit cost (CMV). Null when the client has not informed it.
  cost       Decimal?  @db.Decimal(12, 2)
  stockQty   Int       @map("stock_qty")
  lastSaleAt DateTime? @map("last_sale_at")

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   OrderItem[]

  @@unique([productId, sku])
  @@index([sku])
  @@map("product_variant")
}

/// One row per buyer. The aggregate columns (counts, totals, RFM) are
/// recomputed from orders by the refresh job, never edited by hand.
model Customer {
  id                    String    @id @default(cuid())
  clientId              String    @map("client_id")
  name                  String
  email                 String
  phone                 String?
  city                  String?
  /// Brazilian state code (UF), e.g. "SP".
  province              String?
  /// utm source of the first order, e.g. "meta".
  acquisitionSource     String?   @map("acquisition_source")
  firstOrderAt          DateTime? @map("first_order_at")
  lastOrderAt           DateTime? @map("last_order_at")
  /// Paid orders only.
  ordersCount           Int       @default(0) @map("orders_count")
  totalSpent            Decimal   @default(0) @map("total_spent") @db.Decimal(14, 2)
  daysSinceLastPurchase Int?      @map("days_since_last_purchase")
  /// Quintile scores 1-5 (5 = best).
  rScore                Int?      @map("r_score")
  fScore                Int?      @map("f_score")
  mScore                Int?      @map("m_score")
  /// Portuguese segment label, e.g. "Campeões", "Em risco".
  rfmSegment            String?   @map("rfm_segment")
  createdAt             DateTime  @default(now()) @map("created_at")

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([clientId, email])
  @@index([clientId, rfmSegment])
  @@index([clientId, lastOrderAt])
  @@map("customer")
}

/// A sales order. `totalPrice` = productRevenue + shippingRevenue - totalDiscounts.
model Order {
  id                     String           @id @default(cuid())
  clientId               String           @map("client_id")
  customerId             String           @map("customer_id")
  /// Display number, e.g. "#10432".
  number                 String
  placedAt               DateTime         @map("placed_at")
  paidAt                 DateTime?        @map("paid_at")
  salesPlatform          SalesPlatform    @map("sales_platform")
  /// Channel label, e.g. "Loja Aurora", "Mercado Livre".
  channel                String
  utmSource              String?          @map("utm_source")
  utmMedium              String?          @map("utm_medium")
  utmCampaign            String?          @map("utm_campaign")
  financialStatus        FinancialStatus  @map("financial_status")
  /// Gateway label, e.g. "Pagar.me".
  paymentGateway         String           @map("payment_gateway")
  processingMethod       ProcessingMethod @map("processing_method")
  productRevenue         Decimal          @map("product_revenue") @db.Decimal(12, 2)
  shippingRevenue        Decimal          @map("shipping_revenue") @db.Decimal(12, 2)
  totalDiscounts         Decimal          @map("total_discounts") @db.Decimal(12, 2)
  totalPrice             Decimal          @map("total_price") @db.Decimal(12, 2)
  discountCodes          String[]         @map("discount_codes")
  country                String           @default("BR")
  /// Brazilian state code (UF).
  province               String
  city                   String
  /// 1 for the customer's first order, 2 for the second, and so on.
  orderNumberForCustomer Int              @map("order_number_for_customer")
  itemsCount             Int              @map("items_count")

  client   Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    OrderItem[]

  @@unique([clientId, number])
  @@index([clientId, placedAt])
  @@index([clientId, financialStatus, placedAt])
  @@index([customerId, placedAt])
  @@map("sales_order")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  variantId String   @map("variant_id")
  sku       String
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  /// Cost at the time of sale; null when unknown.
  unitCost  Decimal? @map("unit_cost") @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_item")
}

/// Site traffic and funnel events per day and traffic source (GA4-shaped).
model TrafficDaily {
  id            String   @id @default(cuid())
  clientId      String   @map("client_id")
  date          DateTime @db.Date
  /// e.g. "meta", "google", "(direct)".
  source        String
  /// e.g. "paid-social", "cpc", "organic", "(none)".
  medium        String
  sessions      Int
  users         Int
  newUsers      Int      @map("new_users")
  viewItem      Int      @map("view_item")
  addToCart     Int      @map("add_to_cart")
  beginCheckout Int      @map("begin_checkout")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date, source, medium])
  @@index([clientId, date])
  @@map("traffic_daily")
}

/// Paid media spend per day at the ad level (campaign > ad set > ad).
model AdSpendDaily {
  id                String     @id @default(cuid())
  clientId          String     @map("client_id")
  date              DateTime   @db.Date
  platform          AdPlatform
  campaignId        String     @map("campaign_id")
  campaignName      String     @map("campaign_name")
  adsetId           String     @map("adset_id")
  adsetName         String     @map("adset_name")
  adId              String     @map("ad_id")
  adName            String     @map("ad_name")
  spend             Decimal    @db.Decimal(12, 2)
  /// Platform service fee, kept apart from spend so screens can toggle it.
  platformFee       Decimal    @map("platform_fee") @db.Decimal(12, 2)
  impressions       Int
  clicks            Int
  conversions       Int
  attributedRevenue Decimal    @map("attributed_revenue") @db.Decimal(12, 2)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
  @@index([clientId, platform, date])
  @@index([clientId, campaignId, date])
  @@map("ad_spend_daily")
}

/// Geographic breakdown of the paid media per day and platform (UF of the audience).
model AdSpendRegionDaily {
  id                String     @id @default(cuid())
  clientId          String     @map("client_id")
  date              DateTime   @db.Date
  platform          AdPlatform
  /// Brazilian state code (UF).
  province          String
  spend             Decimal    @db.Decimal(12, 2)
  impressions       Int
  clicks            Int
  conversions       Int
  attributedRevenue Decimal    @map("attributed_revenue") @db.Decimal(12, 2)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date, platform, province])
  @@index([clientId, date])
  @@map("ad_spend_region_daily")
}

enum InfluencerStatus {
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("influencer_status")
}

/// How an influencer is paid. The PERCENT_* modes store percentage points in `value`.
enum InfluencerRuleType {
  FIXED
  DAILY
  WEEKLY
  MONTHLY
  PER_ORDER
  PERCENT_OF_PRODUCTS
  PERCENT_OF_TOTAL

  @@map("influencer_rule_type")
}

/// A creator partnership: remuneration rules plus the coupons that attribute orders.
model Influencer {
  id        String           @id @default(cuid())
  clientId  String           @map("client_id")
  name      String
  handle    String?
  status    InfluencerStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  client  Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rules   InfluencerRule[]
  coupons InfluencerCoupon[]

  @@index([clientId, status])
  @@map("influencer")
}

model InfluencerRule {
  id           String             @id @default(cuid())
  influencerId String             @map("influencer_id")
  type         InfluencerRuleType
  value        Decimal            @db.Decimal(12, 2)
  startDate    DateTime           @map("start_date") @db.Date
  endDate      DateTime?          @map("end_date") @db.Date
  /// Ceiling per period (BRL); null means no ceiling.
  cap          Decimal?           @db.Decimal(12, 2)
  notes        String?
  position     Int

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId])
  @@map("influencer_rule")
}

model InfluencerCoupon {
  id           String    @id @default(cuid())
  influencerId String    @map("influencer_id")
  code         String
  activeFrom   DateTime? @map("active_from") @db.Date
  activeUntil  DateTime? @map("active_until") @db.Date

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId])
  @@map("influencer_coupon")
}

/// Monthly goal inputs (six drivers); the goals engine derives the other KPIs.
model Goal {
  id             String   @id @default(cuid())
  clientId       String   @map("client_id")
  year           Int
  /// 1 to 12.
  month          Int
  totalSold      Decimal  @map("total_sold") @db.Decimal(12, 2)
  averageTicket  Decimal  @map("average_ticket") @db.Decimal(12, 2)
  /// Percent, e.g. 1.85.
  conversionRate Decimal  @map("conversion_rate") @db.Decimal(6, 3)
  paidTraffic    Decimal  @map("paid_traffic") @db.Decimal(12, 2)
  otherMarketing Decimal  @map("other_marketing") @db.Decimal(12, 2)
  /// Percent, e.g. 15.
  repurchaseRate Decimal  @map("repurchase_rate") @db.Decimal(6, 3)
  updatedAt      DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, year, month])
  @@map("goal")
}

/// A cost or expense rule feeding the DRE, margins and profit.
model CostExpense {
  id           String        @id @default(cuid())
  clientId     String        @map("client_id")
  name         String
  description  String?
  businessUnit BusinessUnit  @map("business_unit")
  category     CostCategory
  /// Stable key within the category, e.g. "gateway", "marketplace_fee".
  subcategory  String
  frequency    CostFrequency
  /// Amount in BRL, or percentage points for the PERCENT_* frequencies.
  value        Decimal       @db.Decimal(14, 4)
  startDate    DateTime      @map("start_date") @db.Date
  endDate      DateTime?     @map("end_date") @db.Date
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, startDate])
  @@map("cost_expense")
}

/// A store: the tenant. Every fact table hangs from it.
model Client {
  id                 String    @id @default(cuid())
  /// URL-safe identifier, e.g. "loja-exemplo".
  slug               String    @unique
  name               String
  segment            String?
  /// Connector key of the storefront/ERP the store runs on.
  platform           String?
  monthlyRevenueBand String?   @map("monthly_revenue_band")
  timezone           String    @default("America/Sao_Paulo")
  onboardedAt        DateTime? @map("onboarded_at")
  /// Set by an admin when the engagement ends; clients are blocked, data stays.
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  users              User[]
  consultants        ConsultantAssignment[]
  invitations        Invitation[]
  pillars            Pillar[]
  recommendations    Recommendation[]
  milestoneCriteria  MilestoneCriterion[]
  manualKpiValues    ManualKpiValue[]
  dataSources        DataSource[]
  connectionRequests ConnectionRequest[]
  importJobs         ImportJob[]
  products           Product[]
  customers          Customer[]
  orders             Order[]
  trafficDaily       TrafficDaily[]
  adSpendDaily       AdSpendDaily[]
  adSpendRegionDaily AdSpendRegionDaily[]
  costExpenses       CostExpense[]
  goals              Goal[]
  influencers        Influencer[]
  auditEvents        AuditEvent[]
  subscription       Subscription?
  contract           Contract?

  @@map("client")
}

enum GuruWebhookKind {
  SELL
  SUBSCRIPTION

  @@map("guru_webhook_kind")
}

/// Every delivery from the Guru, keyed by its id (transaction or subscription) so retries
/// update the row instead of duplicating it. `payload` is the whole body as it arrived.
model GuruWebhook {
  id            String          @id @default(cuid())
  guruId        String          @unique @map("guru_id")
  kind          GuruWebhookKind
  email         String
  status        String
  invoiceStatus String?         @map("invoice_status")
  payload       Json
  processedAt   DateTime?       @map("processed_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([email, createdAt])
  @@map("guru_webhook")
}

enum SubscriptionSource {
  GURU
  MANUAL

  @@map("subscription_source")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED

  @@map("subscription_status")
}

/// The commercial state of an e-mail, linked to the store its user creates. Derived from the
/// Guru webhooks (source GURU) or granted by an admin (source MANUAL).
model Subscription {
  id                 String             @id @default(cuid())
  email              String             @unique
  clientId           String?            @unique @map("client_id")
  source             SubscriptionSource
  status             SubscriptionStatus
  guruSubscriptionId String?            @map("guru_subscription_id")
  planName           String?            @map("plan_name")
  contactName        String?            @map("contact_name")
  amount             Decimal?           @db.Decimal(12, 2)
  installments       Int?
  startedAt          DateTime?          @map("started_at")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  canceledAt         DateTime?          @map("canceled_at")
  lastEventAt        DateTime           @map("last_event_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("subscription")
}

enum ContractStatus {
  PENDING
  SIGNED
  REFUSED
  DELETED
  EXPIRED

  @@map("contract_status")
}

/// The consulting contract of a store in ZapSign; upserted by the doc token from the
/// creation response and from every webhook event.
model Contract {
  id            String         @id @default(cuid())
  clientId      String         @unique @map("client_id")
  zapsignToken  String         @unique @map("zapsign_token")
  signerToken   String?        @map("signer_token")
  signerEmail   String         @map("signer_email")
  status        ContractStatus @default(PENDING)
  signedAt      DateTime?      @map("signed_at")
  signedFileUrl String?        @map("signed_file_url")
  payload       Json
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("contract")
}

/// Who did what on a store. `clientId` is null for events outside any store (inviting a
/// consultant). Actor name and role are copied at write so the entry survives the user.
model AuditEvent {
  id        String   @id @default(cuid())
  clientId  String?  @map("client_id")
  actorId   String?  @map("actor_id")
  actorName String   @map("actor_name")
  actorRole UserRole @map("actor_role")
  /// Closed set in packages/contracts/src/audit.
  action    String
  /// Portuguese sentence produced at write.
  summary   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([actorId])
  @@map("audit_event")
}

/// One pillar of the engagement for one store; the titles and the KPI list come from the
/// template in contracts, the status and the pending note are the consultant's.
model Pillar {
  id          String       @id @default(cuid())
  clientId    String       @map("client_id")
  areaKey     String       @map("area_key")
  key         String
  status      PillarStatus
  dataPending String?      @map("data_pending")
  position    Int

  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]

  @@unique([clientId, key])
  @@index([clientId, areaKey])
  @@map("pillar")
}

model Recommendation {
  id        String    @id @default(cuid())
  clientId  String    @map("client_id")
  pillarId  String?   @map("pillar_id")
  text      String
  dueDate   DateTime  @map("due_date") @db.Date
  owner     String
  doneAt    DateTime? @map("done_at")
  position  Int
  createdAt DateTime  @default(now()) @map("created_at")

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pillar Pillar? @relation(fields: [pillarId], references: [id], onDelete: Cascade)

  @@index([clientId, doneAt])
  @@index([pillarId])
  @@map("recommendation")
}

model MilestoneCriterion {
  id       String  @id @default(cuid())
  clientId String  @map("client_id")
  key      String
  /// 0-100, drives the progress bar.
  progress Int     @default(0)
  achieved Boolean @default(false)
  note     String  @default("")
  position Int

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, key])
  @@map("milestone_criterion")
}

/// A KPI the consultant informs by hand for a pillar (no data source feeds it).
model ManualKpiValue {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  pillarKey String   @map("pillar_key")
  kpiKey    String   @map("kpi_key")
  value     String
  delta     String?
  fidelity  Fidelity
  note      String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, pillarKey, kpiKey])
  @@map("manual_kpi_value")
}

model DataSource {
  id           String           @id @default(cuid())
  clientId     String           @map("client_id")
  /// Key in the connector catalog (contracts), e.g. "meta_ads".
  connectorKey String           @map("connector_key")
  name         String
  /// Display category, e.g. "ERP", "Mídia paga".
  kind         String
  status       DataSourceStatus
  lastSyncedAt DateTime?        @map("last_synced_at")
  position     Int

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, connectorKey])
  @@map("data_source")
}

model ConnectionRequest {
  id            String                  @id @default(cuid())
  clientId      String                  @map("client_id")
  connectorKey  String                  @map("connector_key")
  status        ConnectionRequestStatus @default(REQUESTED)
  note          String                  @default("")
  requestedById String?                 @map("requested_by_id")
  createdAt     DateTime                @default(now()) @map("created_at")
  resolvedAt    DateTime?               @map("resolved_at")

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy User?  @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@map("connection_request")
}

