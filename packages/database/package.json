{
  "name": "@ecommerce/database",
  "version": "0.1.0",
  "description": "Prisma schema, migrations, seed and client factory shared by the server-side workspaces",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./enums": "./src/generated/prisma/enums.ts",
    "./passwordHash": "./src/passwordHash.ts",
    "./provisionStore": "./src/provisionStore.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "reset": "prisma migrate reset --force",
    "test": "vitest run",
    "seed:dev": "tsx prisma/seedDev.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0",
    "@ecommerce/contracts": "*"
  }
}
