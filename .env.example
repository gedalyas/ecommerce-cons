# Copy to .env (`make env`) and adjust if needed. .env is gitignored.

# Postgres credentials used by the `postgres` service in docker-compose.yml.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce_insights
POSTGRES_PORT=5432

# Connection string used by Prisma and by the app.
# Host `localhost` when the app runs on the host (make ecom);
# host `postgres` when the app runs inside the compose network (make up).
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/ecommerce_insights?schema=public

# Dev/preview server port.
PORT=8080

# API (apps/api). JWT_SECRET must be a long random string outside local dev.
API_PORT=3001
JWT_SECRET=dev-only-change-me-please-32-chars-min
CORS_ORIGINS=http://localhost:8080
# First administrator, created by `npm run db:seed`.
ADMIN_EMAIL=admin@ecommerce-insights.dev
ADMIN_PASSWORD=admin2026
ADMIN_NAME=Administrador
# Development-only synthetic store (`npm run db:seed:dev`): password of its client and consultant users.
SEED_USER_PASSWORD=exemplo2026
# Pin the API clock to a day (YYYY-MM-DD) so the dev dataset (which ends on 2026-09-10) looks current.
# Leave empty in production.
DEMO_TODAY=2026-09-10

# E-mail (apps/api). Links in messages point to APP_URL. With SMTP_URL set (smtp://user:pass@host:587,
# smtps:// for 465) messages go out through that server; without it, in development, each message is
# written as a file to MAIL_OUTBOX_DIR (relative to apps/api). Production refuses to start without SMTP_URL.
APP_URL=http://localhost:8080
MAIL_FROM=E-commerce Insights <no-reply@localhost>
SMTP_URL=
MAIL_OUTBOX_DIR=outbox

# Web (apps/web): where the API answers and the secret sealing the session cookie.
API_URL=http://localhost:3001
SESSION_SECRET=dev-only-session-secret-change-me-32

# Billing (Digital Manager Guru) and contract (ZapSign). Leave empty until the accounts exist:
# without GURU_ACCOUNT_TOKEN the Guru webhooks answer 401; without ZAPSIGN_API_TOKEN no contract is created.
GURU_ACCOUNT_TOKEN=
GURU_OFFER_IDS=
GURU_CHECKOUT_URL=
ZAPSIGN_API_TOKEN=
ZAPSIGN_API_BASE_URL=https://api.zapsign.com.br
ZAPSIGN_TEMPLATE_ID=
ZAPSIGN_WEBHOOK_SECRET=
ZAPSIGN_SANDBOX=false

# Connectors: the public URL of the API (OAuth callbacks) and the key that seals stored credentials
# (32 random bytes in base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
API_PUBLIC_URL=http://localhost:3001
CREDENTIALS_KEY=

# Connector apps. A connector only appears as "Conectar" when its app credentials are set.
CONNECTOR_USER_AGENT=E-commerce Insights (contato@ecommerce-insights.dev)
CONNECTOR_BACKFILL_MONTHS=18
NUVEMSHOP_APP_ID=
NUVEMSHOP_CLIENT_SECRET=
NUVEMSHOP_AUTH_URL=https://www.nuvemshop.com.br
NUVEMSHOP_API_URL=https://api.nuvemshop.com.br/v1
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_AUTH_URL=https://www.bling.com.br
BLING_API_URL=https://www.bling.com.br/Api/v3
BLING_MIN_INTERVAL_MS=350
