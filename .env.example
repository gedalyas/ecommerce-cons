# Copy to .env (`make env`) and adjust if needed. .env is gitignored.

# Postgres credentials used by the `postgres` service in docker-compose.yml.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce_insights
POSTGRES_PORT=5432

# Connection string used by Prisma and by the app.
# Host `localhost` when the app runs on the host (make ecom);
# host `postgres` when the app runs inside the compose network (make up).
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/ecommerce_insights?schema=public

# Dev/preview server port.
PORT=8090

# API (apps/api). JWT_SECRET must be a long random string outside local dev.
# API_PORT is the local port; without it the API uses the hosting provider's PORT (Railway). Deploy: docs/deploy.md.
API_PORT=3090
JWT_SECRET=dev-only-change-me-please-32-chars-min
CORS_ORIGINS=http://localhost:8090
# First administrator, created by `npm run db:seed`.
ADMIN_EMAIL=admin@ecommerce-insights.dev
ADMIN_PASSWORD=admin2026
ADMIN_NAME=Administrador
# Development-only synthetic store (`npm run db:seed:dev`): password of its client and consultant users.
SEED_USER_PASSWORD=exemplo2026
# Pin the API clock to a day (YYYY-MM-DD) so the dev dataset (which ends on 2026-09-10) looks current.
# Leave empty in production.
DEMO_TODAY=2026-09-10

# Claude (apps/api): "Sugerir com IA" on the spreadsheet import. Empty = the button is hidden and
# the mapping stays manual. ANTHROPIC_BASE_URL only for a local stub.
ANTHROPIC_API_KEY=

# E-mail (apps/api). Links in messages point to APP_URL. With SMTP_URL set (smtp://user:pass@host:587,
# smtps:// for 465) messages go out through that server; without it, in development, each message is
# written as a file to MAIL_OUTBOX_DIR (relative to apps/api). Production refuses to start without SMTP_URL.
APP_URL=http://localhost:8090
MAIL_FROM=E-commerce Insights <no-reply@localhost>
SMTP_URL=
MAIL_OUTBOX_DIR=outbox

# Web (apps/web): where the API answers and the secret sealing the session cookie.
API_URL=http://localhost:3090
SESSION_SECRET=dev-only-session-secret-change-me-32

# Billing (Digital Manager Guru) and contract (ZapSign). Leave empty until the accounts exist:
# without GURU_ACCOUNT_TOKEN the Guru webhooks answer 401; without ZAPSIGN_API_TOKEN no contract is created.
GURU_ACCOUNT_TOKEN=
GURU_OFFER_IDS=
GURU_CHECKOUT_URL=
ZAPSIGN_API_TOKEN=
ZAPSIGN_API_BASE_URL=https://api.zapsign.com.br
ZAPSIGN_TEMPLATE_ID=
ZAPSIGN_WEBHOOK_SECRET=
ZAPSIGN_SANDBOX=false

# Connectors: the public URL of the API (OAuth callbacks) and the key that seals stored credentials
# (32 random bytes in base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
API_PUBLIC_URL=http://localhost:3090
CREDENTIALS_KEY=

# Connector apps. A connector only appears as "Conectar" when its app credentials are set.
CONNECTOR_USER_AGENT=E-commerce Insights (contato@ecommerce-insights.dev)
CONNECTOR_BACKFILL_MONTHS=18
NUVEMSHOP_APP_ID=
NUVEMSHOP_CLIENT_SECRET=
NUVEMSHOP_AUTH_URL=https://www.nuvemshop.com.br
NUVEMSHOP_API_URL=https://api.nuvemshop.com.br/v1
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_AUTH_URL=https://www.bling.com.br
BLING_API_URL=https://www.bling.com.br/Api/v3
BLING_MIN_INTERVAL_MS=350
# Mercado Livre (aplicação em developers.mercadolivre.com.br).
MERCADO_LIVRE_APP_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_AUTH_URL=https://auth.mercadolivre.com.br
MERCADO_LIVRE_API_URL=https://api.mercadolibre.com
# Amazon Selling Partner API (app no Seller Central + Login with Amazon). AMAZON_APP_DRAFT=true adds
# version=beta to the consent URL while the app is not published. Marketplace id: Brasil.
AMAZON_APP_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_CONSENT_URL=https://sellercentral.amazon.com.br/apps/authorize/consent
AMAZON_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_API_URL=https://sellingpartnerapi-na.amazon.com
AMAZON_MARKETPLACE_ID=A2Q3Y263D00KWC
AMAZON_APP_DRAFT=true
# Amazon rate limits: 1 orders call per minute (burst 20), 1 order-items call per 2 s (burst 30).
AMAZON_ORDERS_INTERVAL_MS=60000
AMAZON_ITEMS_INTERVAL_MS=2000
# Google (one Cloud project serves Google Ads and GA4). Leave the client id empty until the OAuth consent
# screen exists; the developer token and the MCC id come from the Google Ads API Center.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_ADS_API_URL=https://googleads.googleapis.com/v19
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GA4_DATA_API_URL=https://analyticsdata.googleapis.com/v1beta
GA4_ADMIN_API_URL=https://analyticsadmin.googleapis.com/v1beta
# Meta (Facebook Login for Business + Marketing API). Empty until the app and the business verification exist.
# The same app serves Meta Ads and the organic Instagram/Facebook connector (page + instagram permissions).
META_APP_ID=
META_APP_SECRET=
META_AUTH_URL=https://www.facebook.com/v21.0/dialog/oauth
META_GRAPH_URL=https://graph.facebook.com/v21.0
# Shopify (Dev Dashboard app, custom distribution). SHOPIFY_SHOP_BASE_URL is only for a local stub.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_orders,read_all_orders,read_products,read_customers
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SHOP_BASE_URL=
# TikTok for Business app.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_AUTH_URL=https://business-api.tiktok.com/portal/auth
TIKTOK_API_URL=https://business-api.tiktok.com/open_api/v1.3
