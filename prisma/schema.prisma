// Data model for the e-commerce consulting dashboard.
//
// The app still renders the mocks under src/features/*/data - this schema is the
// target shape those mocks are migrating to. See specs/data-layer-migration.md.
//
// Naming: models and fields in English, @@map/@map to snake_case tables and
// columns. Values that reach the screen (labels, notes, recommendations) are
// stored in Portuguese because they are user-facing copy, not identifiers.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts `url` here: the connection string for migrate and
// introspection lives in prisma.config.ts, and the client gets a driver adapter.
datasource db {
  provider = "postgresql"
}

/// Data confidence seal shown next to every KPI.
/// A = measured, B = approximated, C = indicative.
enum Fidelity {
  A
  B
  C

  @@map("fidelity")
}

/// Direction of the month-over-month delta, as rendered (green/red/neutral).
enum DeltaDirection {
  UP
  DOWN
  NEUTRAL

  @@map("delta_direction")
}

/// Progress of a pillar inside a section.
enum PillarStatus {
  DONE
  IN_PROGRESS
  NOT_STARTED
  BLOCKED

  @@map("pillar_status")
}

/// Sync state of an external data source.
enum DataSourceStatus {
  CONNECTED
  ERROR
  NOT_CONNECTED
  MANUAL

  @@map("data_source_status")
}

enum MessageRole {
  USER
  ASSISTANT

  @@map("message_role")
}

// ---------------------------------------------------------------------------
// Analytics facts (specs/data-module-plan.md). Everything the data screens
// show is a query over these tables; the presentation models above stay as
// the consulting layer on top.
// ---------------------------------------------------------------------------

/// Where the order was sold: the store's own site or a marketplace.
enum SalesPlatform {
  ECOMMERCE
  MARKETPLACE

  @@map("sales_platform")
}

/// Payment state of an order. Only PAID counts as revenue.
enum FinancialStatus {
  PAID
  PENDING
  AUTHORIZED
  CANCELLED
  REFUNDED

  @@map("financial_status")
}

enum ProcessingMethod {
  CREDIT_CARD
  PIX
  BOLETO

  @@map("processing_method")
}

enum AdPlatform {
  META
  GOOGLE
  TIKTOK

  @@map("ad_platform")
}

/// Which side of the business a cost belongs to.
enum BusinessUnit {
  ECOMMERCE
  MARKETPLACE
  BOTH

  @@map("business_unit")
}

/// Top-level DRE line a cost rolls into.
enum CostCategory {
  COGS
  SALES_MARKETING
  OPERATIONAL

  @@map("cost_category")
}

/// How a cost accrues. The PERCENT_* modes store percentage points in `value`.
enum CostFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  ONE_TIME
  PER_ORDER
  PERCENT_PER_ORDER
  PERCENT_OF_AD_SPEND

  @@map("cost_frequency")
}

/// Catalog product. Prices, costs and stock live on the variant.
model Product {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id")
  name        String
  /// Portuguese labels, e.g. "Decoração".
  category    String
  subcategory String?
  brand       String?
  collection  String?
  createdAt   DateTime @default(now()) @map("created_at")

  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  variants ProductVariant[]
  items    OrderItem[]

  @@index([clientId, category])
  @@map("product")
}

/// Sellable unit (SKU). Single-variant products have exactly one with name null.
model ProductVariant {
  id         String    @id @default(cuid())
  productId  String    @map("product_id")
  sku        String
  /// Variant label, e.g. "Azul · M". Null for single-variant products.
  name       String?
  price      Decimal   @db.Decimal(12, 2)
  /// Unit cost (CMV). Null when the client has not informed it.
  cost       Decimal?  @db.Decimal(12, 2)
  stockQty   Int       @map("stock_qty")
  lastSaleAt DateTime? @map("last_sale_at")

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   OrderItem[]

  @@unique([productId, sku])
  @@index([sku])
  @@map("product_variant")
}

/// One row per buyer. The aggregate columns (counts, totals, RFM) are
/// recomputed from orders by the refresh job, never edited by hand.
model Customer {
  id                    String    @id @default(cuid())
  clientId              String    @map("client_id")
  name                  String
  email                 String
  phone                 String?
  city                  String?
  /// Brazilian state code (UF), e.g. "SP".
  province              String?
  /// utm source of the first order, e.g. "meta".
  acquisitionSource     String?   @map("acquisition_source")
  firstOrderAt          DateTime? @map("first_order_at")
  lastOrderAt           DateTime? @map("last_order_at")
  /// Paid orders only.
  ordersCount           Int       @default(0) @map("orders_count")
  totalSpent            Decimal   @default(0) @map("total_spent") @db.Decimal(14, 2)
  daysSinceLastPurchase Int?      @map("days_since_last_purchase")
  /// Quintile scores 1-5 (5 = best).
  rScore                Int?      @map("r_score")
  fScore                Int?      @map("f_score")
  mScore                Int?      @map("m_score")
  /// Portuguese segment label, e.g. "Campeões", "Em risco".
  rfmSegment            String?   @map("rfm_segment")
  createdAt             DateTime  @default(now()) @map("created_at")

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([clientId, email])
  @@index([clientId, rfmSegment])
  @@index([clientId, lastOrderAt])
  @@map("customer")
}

/// A sales order. `totalPrice` = productRevenue + shippingRevenue - totalDiscounts.
model Order {
  id                     String           @id @default(cuid())
  clientId               String           @map("client_id")
  customerId             String           @map("customer_id")
  /// Display number, e.g. "#10432".
  number                 String
  placedAt               DateTime         @map("placed_at")
  paidAt                 DateTime?        @map("paid_at")
  salesPlatform          SalesPlatform    @map("sales_platform")
  /// Channel label, e.g. "Loja Aurora", "Mercado Livre".
  channel                String
  utmSource              String?          @map("utm_source")
  utmMedium              String?          @map("utm_medium")
  utmCampaign            String?          @map("utm_campaign")
  financialStatus        FinancialStatus  @map("financial_status")
  /// Gateway label, e.g. "Pagar.me".
  paymentGateway         String           @map("payment_gateway")
  processingMethod       ProcessingMethod @map("processing_method")
  productRevenue         Decimal          @map("product_revenue") @db.Decimal(12, 2)
  shippingRevenue        Decimal          @map("shipping_revenue") @db.Decimal(12, 2)
  totalDiscounts         Decimal          @map("total_discounts") @db.Decimal(12, 2)
  totalPrice             Decimal          @map("total_price") @db.Decimal(12, 2)
  discountCodes          String[]         @map("discount_codes")
  country                String           @default("BR")
  /// Brazilian state code (UF).
  province               String
  city                   String
  /// 1 for the customer's first order, 2 for the second, and so on.
  orderNumberForCustomer Int              @map("order_number_for_customer")
  itemsCount             Int              @map("items_count")

  client   Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    OrderItem[]

  @@unique([clientId, number])
  @@index([clientId, placedAt])
  @@index([clientId, financialStatus, placedAt])
  @@index([customerId, placedAt])
  @@map("sales_order")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  variantId String   @map("variant_id")
  sku       String
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  /// Cost at the time of sale; null when unknown.
  unitCost  Decimal? @map("unit_cost") @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_item")
}

/// Site traffic and funnel events per day and traffic source (GA4-shaped).
model TrafficDaily {
  id            String   @id @default(cuid())
  clientId      String   @map("client_id")
  date          DateTime @db.Date
  /// e.g. "meta", "google", "(direct)".
  source        String
  /// e.g. "paid-social", "cpc", "organic", "(none)".
  medium        String
  sessions      Int
  users         Int
  newUsers      Int      @map("new_users")
  viewItem      Int      @map("view_item")
  addToCart     Int      @map("add_to_cart")
  beginCheckout Int      @map("begin_checkout")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date, source, medium])
  @@index([clientId, date])
  @@map("traffic_daily")
}

/// Paid media spend per day at the ad level (campaign > ad set > ad).
model AdSpendDaily {
  id                String     @id @default(cuid())
  clientId          String     @map("client_id")
  date              DateTime   @db.Date
  platform          AdPlatform
  campaignId        String     @map("campaign_id")
  campaignName      String     @map("campaign_name")
  adsetId           String     @map("adset_id")
  adsetName         String     @map("adset_name")
  adId              String     @map("ad_id")
  adName            String     @map("ad_name")
  spend             Decimal    @db.Decimal(12, 2)
  /// Platform service fee, kept apart from spend so screens can toggle it.
  platformFee       Decimal    @map("platform_fee") @db.Decimal(12, 2)
  impressions       Int
  clicks            Int
  conversions       Int
  attributedRevenue Decimal    @map("attributed_revenue") @db.Decimal(12, 2)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
  @@index([clientId, platform, date])
  @@index([clientId, campaignId, date])
  @@map("ad_spend_daily")
}

/// Geographic breakdown of the paid media per day and platform (UF of the audience).
model AdSpendRegionDaily {
  id                String     @id @default(cuid())
  clientId          String     @map("client_id")
  date              DateTime   @db.Date
  platform          AdPlatform
  /// Brazilian state code (UF).
  province          String
  spend             Decimal    @db.Decimal(12, 2)
  impressions       Int
  clicks            Int
  conversions       Int
  attributedRevenue Decimal    @map("attributed_revenue") @db.Decimal(12, 2)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date, platform, province])
  @@index([clientId, date])
  @@map("ad_spend_region_daily")
}

/// Monthly goal inputs (six drivers); the goals engine derives the other KPIs.
model Goal {
  id             String   @id @default(cuid())
  clientId       String   @map("client_id")
  year           Int
  /// 1 to 12.
  month          Int
  totalSold      Decimal  @map("total_sold") @db.Decimal(12, 2)
  averageTicket  Decimal  @map("average_ticket") @db.Decimal(12, 2)
  /// Percent, e.g. 1.85.
  conversionRate Decimal  @map("conversion_rate") @db.Decimal(6, 3)
  paidTraffic    Decimal  @map("paid_traffic") @db.Decimal(12, 2)
  otherMarketing Decimal  @map("other_marketing") @db.Decimal(12, 2)
  /// Percent, e.g. 15.
  repurchaseRate Decimal  @map("repurchase_rate") @db.Decimal(6, 3)
  updatedAt      DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, year, month])
  @@map("goal")
}

/// A cost or expense rule feeding the DRE, margins and profit.
model CostExpense {
  id           String        @id @default(cuid())
  clientId     String        @map("client_id")
  name         String
  description  String?
  businessUnit BusinessUnit  @map("business_unit")
  category     CostCategory
  /// Stable key within the category, e.g. "gateway", "marketplace_fee".
  subcategory  String
  frequency    CostFrequency
  /// Amount in BRL, or percentage points for the PERCENT_* frequencies.
  value        Decimal       @db.Decimal(14, 4)
  startDate    DateTime      @map("start_date") @db.Date
  endDate      DateTime?     @map("end_date") @db.Date
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, startDate])
  @@map("cost_expense")
}

/// A consulting client (the prototype ships a single one: "Loja Aurora").
model Client {
  id        String   @id @default(cuid())
  /// URL-safe identifier, e.g. "loja-aurora".
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections           Section[]
  metrics            Metric[]
  recommendations    Recommendation[]
  alerts             Alert[]
  milestoneCriteria  MilestoneCriterion[]
  dataSources        DataSource[]
  monthlySnapshots   MonthlySnapshot[]
  assistantMessages  AssistantMessage[]
  products           Product[]
  customers          Customer[]
  orders             Order[]
  trafficDaily       TrafficDaily[]
  adSpendDaily       AdSpendDaily[]
  costExpenses       CostExpense[]
  goals              Goal[]
  adSpendRegionDaily AdSpendRegionDaily[]

  @@map("client")
}

/// A top-level area of the dashboard: money, marketing, logistics, management.
model Section {
  id       String @id @default(cuid())
  clientId String @map("client_id")
  /// Stable key used by the UI: "money" | "marketing" | "logistics" | "management".
  key      String
  /// Screen title, in Portuguese.
  title    String
  subtitle String
  /// Display order in the sidebar.
  position Int

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pillars Pillar[]

  @@unique([clientId, key])
  @@map("section")
}

/// A pillar inside a section, rendered as a card with KPIs and recommendations.
model Pillar {
  id          String       @id @default(cuid())
  sectionId   String       @map("section_id")
  /// Stable key, e.g. "acquisition".
  key         String
  title       String
  status      PillarStatus
  /// Footer note listing missing data, when there is any.
  dataPending String?      @map("data_pending")
  /// Id of feature-specific extra content, e.g. "creative-presence".
  extra       String?
  position    Int

  section         Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  metrics         Metric[]
  recommendations Recommendation[]

  @@unique([sectionId, key])
  @@map("pillar")
}

/// A KPI. Belongs to a pillar, or directly to the client when it is one of the
/// four headline metrics on the dashboard.
model Metric {
  id             String          @id @default(cuid())
  clientId       String          @map("client_id")
  pillarId       String?         @map("pillar_id")
  label          String
  /// Pre-formatted display value ("R$ 487.300", "19,2%"). The raw number lives
  /// in rawValue so charts and comparisons do not parse strings.
  value          String
  rawValue       Decimal?        @map("raw_value") @db.Decimal(14, 4)
  unit           String?
  delta          String?
  deltaDirection DeltaDirection? @map("delta_direction")
  subNote        String?         @map("sub_note")
  fidelity       Fidelity
  /// Tooltip explaining where the number came from.
  fidelityNote   String          @map("fidelity_note")
  /// True for the four headline KPIs on the dashboard.
  isHeadline     Boolean         @default(false) @map("is_headline")
  position       Int
  measuredAt     DateTime?       @map("measured_at")

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pillar Pillar? @relation(fields: [pillarId], references: [id], onDelete: Cascade)

  @@index([clientId, isHeadline])
  @@index([pillarId])
  @@map("metric")
}

/// An open recommendation. Belongs to a pillar, or directly to the client when
/// it shows up in the dashboard "Recomendacoes em aberto" block.
model Recommendation {
  id        String    @id @default(cuid())
  clientId  String    @map("client_id")
  pillarId  String?   @map("pillar_id")
  text      String
  /// Display deadline, e.g. "até 05/09".
  dueLabel  String    @map("due_label")
  dueDate   DateTime? @map("due_date") @db.Date
  /// Display owner, e.g. "Marina (Comercial)".
  owner     String
  doneAt    DateTime? @map("done_at")
  position  Int
  createdAt DateTime  @default(now()) @map("created_at")

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pillar Pillar? @relation(fields: [pillarId], references: [id], onDelete: Cascade)

  @@index([clientId, doneAt])
  @@index([pillarId])
  @@map("recommendation")
}

/// One of the "Precisa da sua atenção" cards on the dashboard.
model Alert {
  id        String    @id @default(cuid())
  clientId  String    @map("client_id")
  icon      String
  title     String
  detail    String
  /// Section the alert came from, e.g. "Dinheiro".
  origin    String
  /// Destination path, e.g. "/dinheiro".
  href      String
  position  Int
  createdAt DateTime  @default(now()) @map("created_at")
  clearedAt DateTime? @map("cleared_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, clearedAt])
  @@map("alert")
}

/// One of the four maturity-milestone criteria.
model MilestoneCriterion {
  id       String  @id @default(cuid())
  clientId String  @map("client_id")
  key      String
  name     String
  /// 0-100, drives the progress bar.
  progress Int
  achieved Boolean @default(false)
  /// Short explanation, e.g. "CAC R$ 62 · meta R$ 41".
  note     String
  position Int

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, key])
  @@map("milestone_criterion")
}

/// An external system feeding the dashboard (Bling, Meta Ads, ...).
model DataSource {
  id           String           @id @default(cuid())
  clientId     String           @map("client_id")
  name         String
  /// Display category, e.g. "ERP", "Mídia paga".
  kind         String
  status       DataSourceStatus
  lastSyncedAt DateTime?        @map("last_synced_at")
  /// Display sync label, e.g. "hoje às 03:12". Derived from lastSyncedAt once
  /// the UI reads from the database.
  syncLabel    String           @map("sync_label")
  position     Int

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, name])
  @@map("data_source")
}

/// One point of the 12-month revenue/margin chart.
model MonthlySnapshot {
  id       String   @id @default(cuid())
  clientId String   @map("client_id")
  /// First day of the month the snapshot refers to.
  month    DateTime @db.Date
  /// Display label, e.g. "ago/26".
  label    String
  revenue  Decimal  @db.Decimal(14, 2)
  /// Contribution margin in percentage points, e.g. 19.2.
  margin   Decimal  @db.Decimal(5, 2)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, month])
  @@map("monthly_snapshot")
}

/// A message in the assistant panel. Replies are canned in the prototype.
model AssistantMessage {
  id         String      @id @default(cuid())
  clientId   String      @map("client_id")
  role       MessageRole
  text       String
  /// Origin pillar cited by the answer, e.g. "Marketing · Aquisição".
  pillarRef  String?     @map("pillar_ref")
  /// Whether the message offers the "Levar para a reunião" action.
  forMeeting Boolean     @default(false) @map("for_meeting")
  createdAt  DateTime    @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("assistant_message")
}
